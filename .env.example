# Marketing and previews run without credentials. P2 auth needs the first three values.
# Configure a development project only; see docs/p2-setup.md.
# Public values: bundled into browser code; never use secret/service-role keys here.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_SENTRY_DSN=

# Server only. P2 auth/dog mutations do NOT need SUPABASE_SECRET_KEY.
# P4 anonymous assessments require a random value with at least 32 characters.
ASSESSMENT_TOKEN_SECRET=
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
AI_MODEL_PLANNER=
AI_MODEL_COPY=
AI_MODEL_REVIEW=
AI_GENERATION_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_SINGLE_PROGRAM=
RESEND_API_KEY=
EMAIL_FROM=
# Protege /api/ready e os jobs de retenção. Sem ele, /api/ready responde 404.
CRON_SECRET=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Meta (Facebook e Instagram) — medição de anúncio.
# O pixel só carrega no navegador depois do aceite de cookies, e a conversão de
# servidor só é enviada se houve aceite no momento do checkout.
# O ID do pixel é público por natureza; o token da Conversions API é segredo e
# nunca deve ir para uma variável NEXT_PUBLIC_.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Preencher apenas ao validar no Gerenciador de Eventos. Vazio em produção.
META_TEST_EVENT_CODE=

# Disposable local/test database ONLY. See docs/testing.md.
TEST_DATABASE_URL=
